{
  "name": "even-deskless-bare",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "verify:l0": "npm run typecheck && npm test",
    "sim": "evenhub-simulator http://127.0.0.1:5173",
    "qr": "evenhub qr --url http://127.0.0.1:5173",
    "qr:tunnel": "bash ../../scripts/qr-tunnel.sh",
    "pack": "npm run build && evenhub pack app.json dist -o even-deskless-bare.ehpk"
  },
  "dependencies": {
    "@evenrealities/even_hub_sdk": "0.0.14"
  },
  "devDependencies": {
    "@evenrealities/evenhub-cli": "0.1.14",
    "@evenrealities/evenhub-simulator": "^0.9.3",
    "pngjs": "^7.0.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  }
}
